{
  "name": "academic-life-functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && npx -y firebase-tools@latest emulators:start --only functions",
    "shell": "npm run build && npx -y firebase-tools@latest functions:shell",
    "start": "npm run shell",
    "deploy": "npx -y firebase-tools@latest deploy --only functions",
    "logs": "npx -y firebase-tools@latest functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.0",
    "openai": "^4.85.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "firebase-functions-test": "^3.4.0",
    "typescript": "^5.7.3"
  },
  "private": true
}
